{
  "name": "elster-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the German tax portal ELSTER: fill any form (ESt, EÜR, UStVA, …) by Kennzahl, check and review it, read past submissions. It never submits; you click send.",
  "mcpName": "io.github.Infraviored/elster-mcp-server",
  "type": "module",
  "homepage": "https://github.com/Infraviored/elster-mcp-server",
  "bugs": "https://github.com/Infraviored/elster-mcp-server/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infraviored/elster-mcp-server.git"
  },
  "author": "Florian Schneider",
  "contributors": [
    "Lukas Schwarz <mail@lukasschwarz.info> (original click-based version)"
  ],
  "main": "dist/index.js",
  "bin": {
    "elster-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elster",
    "ustva",
    "euer",
    "est",
    "tax",
    "steuer",
    "finanzamt",
    "germany",
    "puppeteer",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "config.example.json"
  ]
}
